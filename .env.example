# Judge0 Configuration
# You can use either the free Judge0 CE instance or RapidAPI

# For RapidAPI (Recommended for production)
VITE_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_JUDGE0_API_URL=http://localhost:2358
#VITE_JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# For self-hosted Judge0 CE (Development)
# VITE_JUDGE0_API_URL=http://localhost:2358
# VITE_JUDGE0_API_KEY=your_api_key_here

# Other configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
